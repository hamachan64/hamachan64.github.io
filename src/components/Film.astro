---
/**
 * YouTube はクリックされるまで読み込まない（ポスターは作品画像）。
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  poster?: ImageMetadata;
  aspect?: 'vertical' | 'wide';
}

const { id, title, poster, aspect = 'vertical' } = Astro.props;
---

<div class:list={['film', `is-${aspect}`]} data-clip>
  <button class="film-btn" type="button" data-film={id} aria-label={`${title} を再生`}>
    {poster && <Image src={poster} alt="" width={aspect === 'wide' ? 1600 : 800} loading="lazy" />}
    <span class="film-ui">
      <span class="film-play" aria-hidden="true">
        <svg viewBox="0 0 12 14" width="12" height="14"><path d="M0 0 12 7 0 14Z" fill="currentColor"></path></svg>
      </span>
      <span class="label">Play film</span>
    </span>
  </button>
</div>

<style>
  .film {
    position: relative;
    overflow: hidden;
    background: var(--ink);
  }

  .film.is-vertical {
    aspect-ratio: 9 / 16;
  }

  .film.is-wide {
    aspect-ratio: 16 / 9;
  }

  .film-btn,
  .film :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .film-btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.72);
    transition:
      filter 0.9s var(--ease-out),
      transform 1.4s var(--ease-out);
  }

  .film-btn:hover :global(img) {
    filter: grayscale(0) brightness(0.8);
    transform: scale(1.03);
  }

  .film-ui {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    color: var(--paper);
  }

  .film-ui .label {
    color: var(--paper);
  }

  .film-play {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid rgba(235, 233, 228, 0.6);
    padding-left: 3px;
    transition:
      background 0.4s ease,
      color 0.4s ease,
      transform 0.7s var(--ease-out);
  }

  .film-btn:hover .film-play {
    background: var(--paper);
    color: var(--ink);
    transform: scale(1.08);
  }
</style>
