---
import { links as social } from '../lib/links';
const year = new Date().getFullYear();
---

<footer class="footer wrap">
  <p class="label">&copy; {year} Yuki Hamaguchi</p>
  <ul>
    {
      social.map((s) => (
        <li>
          <a class="label label-ink" href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label} ↗
          </a>
        </li>
      ))
    }
  </ul>
  <a class="label label-ink totop" href="#top">Back to top ↑</a>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gutter);
    padding-block: 22px 26px;
    border-top: 1px solid var(--line);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    justify-content: center;
  }

  .totop {
    justify-self: end;
  }

  a:hover {
    color: var(--mute);
  }

  @media (max-width: 760px) {
    .footer {
      grid-template-columns: 1fr auto;
    }

    ul {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }
</style>
