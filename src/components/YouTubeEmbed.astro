---
interface Props {
  id: string;
  title?: string;
  aspect?: 'vertical' | 'wide';
}

const { id, title = 'Demo Video', aspect = 'vertical' } = Astro.props;
---

<div class:list={['yt-embed', `is-${aspect}`]}>
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</div>

<style>
  .yt-embed {
    position: relative;
    margin-inline: auto;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
  }

  .yt-embed.is-vertical {
    aspect-ratio: 9 / 16;
    max-width: 380px;
  }

  .yt-embed.is-wide {
    aspect-ratio: 16 / 9;
    max-width: 860px;
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
