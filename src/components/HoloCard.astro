---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  concept?: string;
  cover?: ImageMetadata;
  href?: string;
  transitionName?: string;
}

const { title, subtitle, concept, cover, href, transitionName } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag class:list={['holo-card', { 'is-link': !!href, 'is-placeholder': !cover }]} href={href}>
  <div class="thumb" transition:name={transitionName}>
    {
      cover ? (
        <Image src={cover} alt={title} width={720} densities={[1, 2]} loading="lazy" />
      ) : (
        <div class="thumb-empty font-head" aria-hidden="true">
          ???
        </div>
      )
    }
    <span class="sheen" aria-hidden="true"></span>
  </div>
  <div class="info">
    <h3 class="font-head">{title}</h3>
    {subtitle && <p class="meta font-head">{subtitle}</p>}
    {concept && <p class="concept">{concept}</p>}
  </div>
  <span class="edge" aria-hidden="true"></span>
</Tag>

<style>
  .holo-card {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: background 0.3s ease;
    will-change: transform;
  }

  /* ホログラフィックの縁取り */
  .edge {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(110, 231, 255, 0.35),
      rgba(255, 255, 255, 0.06) 40%,
      rgba(255, 139, 216, 0.3)
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .holo-card.is-link:hover {
    background: var(--surface-2);
  }

  .holo-card.is-link:hover .edge {
    opacity: 1;
  }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, #12121f, #1a1a2c);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.7s var(--ease-out);
  }

  .holo-card.is-link:hover .thumb :global(img) {
    transform: scale(1.08);
  }

  .thumb-empty {
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    letter-spacing: 0.4em;
    color: var(--text-faint);
  }

  /* マウス追従のホロ光沢（トレカのホロ加工） */
  .sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    background:
      radial-gradient(
        420px circle at var(--mx) var(--my),
        rgba(255, 255, 255, 0.18),
        transparent 45%
      ),
      conic-gradient(
        from 180deg at var(--mx) var(--my),
        rgba(110, 231, 255, 0.22),
        rgba(167, 139, 250, 0.22),
        rgba(255, 139, 216, 0.22),
        rgba(125, 255, 196, 0.22),
        rgba(110, 231, 255, 0.22)
      );
    mix-blend-mode: color-dodge;
  }

  .holo-card.is-link:hover .sheen {
    opacity: 1;
  }

  .info {
    padding: 22px 24px 26px;
  }

  .info h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 4px;
  }

  .meta {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: var(--grad-holo);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 12px;
  }

  .concept {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .is-placeholder {
    opacity: 0.55;
  }
</style>
