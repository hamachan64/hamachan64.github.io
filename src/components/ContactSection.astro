---
import Lines from './Lines.astro';
import { links } from '../lib/links';

interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section id="contact" class:list={['contact', 'wrap', { 'is-page': standalone }]}>
  <header class="sec-head">
    <h2 class="label label-ink">Contact</h2>
    <span class="label">Available for collaborations</span>
  </header>
  <div class="grid contact-body">
    <Lines as="p" class="contact-title" lines={['Let’s Create', 'Together']} />
    <div class="contact-side">
      <p class="jp contact-lead">制作のご相談・コラボレーションなど、お気軽にご連絡ください。</p>
      <a class="contact-mail" href="mailto:yuuki.hama2186@gmail.com">
        <span class="ul">yuuki.hama2186@gmail.com</span>
        <span class="contact-mail-arrow" aria-hidden="true">↗</span>
      </a>
      <ul class="contact-links">
        {
          links.map((l) => (
            <li>
              <a class="label label-ink ul" href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ============================== Contact ============================== */
  .contact {
    padding-bottom: clamp(100px, 16vh, 180px);
  }

  .contact-body {
    align-items: end;
    row-gap: 48px;
  }

  .contact-title {
    grid-column: 1 / span 8;
    font-family: var(--f-sans);
    font-weight: 500;
    font-size: clamp(56px, 9.4vw, 168px);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .contact-side {
    grid-column: 9 / -1;
    padding-bottom: 0.6em;
  }

  .contact-lead {
    font-size: 14px;
    color: var(--ink-2);
  }

  .contact-mail {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    margin-top: 16px;
    font-size: clamp(18px, 1.7vw, 26px);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 28px;
  }

  .contact-mail-arrow {
    transition: transform 0.6s var(--ease-out);
  }

  .contact-mail:hover .contact-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }

  @media (max-width: 1100px) {
    .contact-title {
      grid-column: 1 / -1;
    }

    .contact-side {
      grid-column: 1 / span 8;
    }
  }

  @media (max-width: 760px) {
    .contact-side {
      grid-column: 1 / -1;
    }
  }

  /* 専用ページ：ヘッダーの下から始める */
  .contact.is-page {
    padding-top: calc(var(--header-h) + 48px);
  }
</style>
