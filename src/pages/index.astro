---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import { previewSrc } from '../lib/images';
import portraitWide from '../../assets/images/profile.jpg';
import portraitTall from '../../assets/images/profile_t.jpg';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const released = works.filter((w) => !w.data.comingSoon);
const pad = (n: number) => String(n).padStart(2, '0');

// 公開済みの作品：1件ずつ画像を大きく見せる
const items = await Promise.all(
  released.map(async (w) => {
    const img = (w.data.card ?? w.data.cover)!;
    const [fx, fy] = w.data.cardFocus.split(/\s+/);
    return {
      id: w.id,
      no: pad(w.data.order),
      title: w.data.title,
      subtitle: w.data.subtitle,
      tech: w.data.tech,
      year: w.data.year,
      focus: w.data.cardFocus,
      position: `${Number(fx) * 100}% ${Number(fy) * 100}%`,
      src: await previewSrc(img),
    };
  })
);
// 制作中の作品と、未発表の枠（画像は出さず、一覧の最後に小さく添える）
const upcoming = [
  ...works
    .filter((w) => w.data.comingSoon)
    .map((w) => ({ no: pad(w.data.order), title: w.data.title, note: w.data.subtitle })),
  ...[works.length + 1, works.length + 2].map((n) => ({ no: pad(n), title: 'Coming soon', note: '' })),
];

// Hero：PC は横長、モバイルは縦長。どちらも本人と鏡像が向かい合う構図
const wide = await getImage({ src: portraitWide, widths: [720, 1024], format: 'webp', quality: 86 });
const tall = await getImage({ src: portraitTall, widths: [480, 682], format: 'webp', quality: 86 });
// 継ぎ目（本人と鏡像の境）の位置。画像幅に対する割合
const PORTRAIT_SEAM = 0.4902; // profile.jpg
const PORTRAIT_SEAM_TALL = 0.4912; // profile_t.jpg

// 名前は1文字ずつ立ち上げる
const nameLines = ['Yuki', 'Hamaguchi'].map((w) =>
  [...w].map((c, i) => `<span class="ch" style="--c:${i}">${c}</span>`).join('')
);

const disciplines = ['AR / XR Experience', 'WebAR', 'Spatial Computing', 'Card & Game Design', 'Direction'];
const tools = ['Unity', 'Shader Graph', 'AR Foundation', 'Swift / visionOS', 'PICO'];
---

<Base title="Yuki Hamaguchi — AR Card Creator / XR Engineer">
  <main id="top">
    <!-- ================================ HERO ================================ -->
    <section class="hero wrap" aria-label="Introduction">
      <figure
        class="hero-photo glass"
        data-glass
        data-src={wide.src}
        data-seam={PORTRAIT_SEAM}
        data-src-tall={tall.src}
        data-seam-tall={PORTRAIT_SEAM_TALL}
        data-focus="0.5 0.32"
        data-clip
        data-manual
      >
        <picture>
          <source media="(max-width: 760px)" srcset={tall.srcSet.attribute} sizes="100vw" />
          <img
            src={wide.src}
            srcset={wide.srcSet.attribute}
            sizes="(max-width: 760px) 100vw, 75vw"
            width="1024"
            height="819"
            alt="Yuki Hamaguchi のポートレート。ガラスに映った自分と向かい合っている"
            fetchpriority="high"
          />
        </picture>
        <figcaption class="hero-photo-caps" aria-hidden="true">
          <span>Physical</span>
          <span>Virtual</span>
        </figcaption>
      </figure>

      <div class="hero-left">
        <p class="label" data-fade data-manual style="--d: 500ms">Portfolio 2025—2026</p>
        <Lines
          as="p"
          class="hero-tagline jp"
          lines={['一枚のカードから、', '世界が立ち上がる。']}
          delay={560}
          manual
        />
        <p class="hero-en" data-fade data-manual style="--d: 760ms">
          Immersive experiences that begin<br />with a single card in your hand.
        </p>
      </div>

      <p class="hero-meta label" data-fade data-manual style="--d: 840ms">
        Based in Tokyo<br />
        <a href="#works" class="ul label-ink">Selected works <span class="num">01—{pad(released.length)}</span></a>
      </p>

      <Lines as="h1" class="hero-name display by-char" lines={nameLines} manual delay={350} data-fit />

      <p class="hero-scroll label" data-fade data-manual style="--d: 1100ms">
        <a href="#about">Scroll</a>
        <span class="hero-hint"><span class="hint-fine">Touch</span><span class="hint-touch">Tap</span> the reflection</span>
        <span class="hero-scroll-arrow" aria-hidden="true">↓</span>
      </p>
    </section>

    <!-- ================================ ABOUT =============================== -->
    <section id="about" class="about wrap">
      <header class="sec-head">
        <h2 class="label label-ink">About</h2>
        <span class="label">日本語 / English</span>
      </header>

      <div class="grid about-mirror">
        <div class="about-ja" lang="ja">
          <Lines
            as="p"
            class="statement"
            lines={['カードは、手のひらに収まる', 'いちばん小さな世界の入口。', 'XR の技術で、その向こう側を', 'つくっています。']}
          />
          <div class="about-body jp">
            <p>
              東京を拠点に活動する XR エンジニア／クリエイター。XR 技術をコアに据え、カードをはじめとする物理メディアへ体験を落とし込むことで、現実の延長線上にある非日常をデザインしています。
            </p>
            <p>触れられるものと、触れられないもの。その境界で人の心が動く瞬間をつくることが、私のテーマです。</p>
          </div>
        </div>

        <div class="about-en" lang="en">
          <Lines
            as="p"
            class="statement-en"
            lines={['A card is the smallest', 'doorway to a world —', 'one that fits in your palm.', 'I build what lies beyond it.']}
            delay={160}
          />
          <div class="about-body">
            <p>
              I'm a Tokyo-based XR engineer and creator. With XR at the core, I translate experiences into physical
              media — cards above all — to design the extraordinary that sits just beyond everyday reality.
            </p>
          </div>
        </div>
      </div>

      <div class="grid about-lists">
        <div>
          <h3 class="label">Disciplines</h3>
          <ul>{disciplines.map((d) => <li>{d}</li>)}</ul>
        </div>
        <div>
          <h3 class="label">Tools</h3>
          <ul>{tools.map((d) => <li>{d}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- ================================ WORKS =============================== -->
    <section id="works" class="works wrap">
      <header class="sec-head">
        <h2 class="label label-ink">Selected Works</h2>
        <span class="label num">2025—2026 · {pad(released.length)} projects</span>
      </header>

      <ol class="grid works-grid">
        {
          items.map((w, i) => (
            <li class:list={['work', `slot-${i % 6}`]}>
              <a class="work-link" href={`/${w.id}`}>
                <figure class="work-img glass" data-glass="lazy" data-src={w.src} data-focus={w.focus} data-clip>
                  <img src={w.src} alt="" loading={i < 2 ? 'eager' : 'lazy'} style={`object-position:${w.position}`} />
                </figure>
                <span class="work-meta">
                  <span class="work-no label num">{w.no}</span>
                  <span class="work-main">
                    <span class="work-title">
                      {w.title}
                      <span class="work-arrow" aria-hidden="true">
                        →
                      </span>
                    </span>
                    <span class="label">{w.subtitle}</span>
                  </span>
                  <span class="work-side label">
                    <span class="num">{w.year}</span>
                    <span>{w.tech}</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="upcoming">
        <h3 class="label label-ink">In the works</h3>
        <ol>
          {
            upcoming.map((u) => (
              <li class="label">
                <span class="num">{u.no}</span>
                <span class="upcoming-title">{u.title}</span>
                <span>{u.note || '—'}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- =============================== CONTACT ============================== -->
    <section id="contact" class="contact wrap">
      <header class="sec-head">
        <h2 class="label label-ink">Contact</h2>
        <span class="label">Available for collaborations</span>
      </header>
      <div class="grid contact-body">
        <Lines as="p" class="contact-title" lines={['Have a card', 'in mind?']} />
        <div class="contact-side">
          <p class="jp contact-lead">制作のご相談・コラボレーションなど、お気軽にご連絡ください。</p>
          <a class="contact-mail" href="mailto:yuuki.hama2186@gmail.com">
            <span class="ul">yuuki.hama2186@gmail.com</span>
            <span class="contact-mail-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* =============================== Hero =============================== */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto auto;
    column-gap: var(--gutter);
    padding-top: calc(var(--header-h) + 4px);
  }

  /* 主役：本人と鏡像のポートレート */
  .hero-photo {
    grid-column: 4 / -1;
    grid-row: 1 / span 2;
    margin: 0;
    background: #161615;
  }

  .hero-photo img {
    object-position: 50% 32%;
    filter: contrast(1.1) brightness(0.98);
  }

  .hero-photo-caps {
    position: absolute;
    inset: 14px 16px auto;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: rgba(235, 233, 228, 0.7);
    pointer-events: none;
  }

  .hero-left {
    grid-column: 1 / span 3;
    grid-row: 1;
    align-self: start;
    padding-top: clamp(16px, 3vh, 32px);
    padding-right: 8px;
  }

  .hero-left > .label:first-child {
    margin-bottom: 18px;
  }

  .hero-tagline {
    font-family: var(--f-min);
    font-weight: 500;
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.55;
    letter-spacing: 0.06em;
  }

  .hero-en {
    margin-top: 14px;
    color: var(--mute);
    font-size: 13px;
    line-height: 1.6;
  }

  .hero-meta {
    grid-column: 1 / span 3;
    grid-row: 1;
    align-self: end;
    margin-bottom: clamp(20px, 3vh, 32px);
    line-height: 1.7;
  }

  .hero-name {
    grid-column: 1 / -1;
    grid-row: 2;
    position: relative;
    z-index: 2;
    /* JS（data-fit）が左右マージンいっぱいに合わせる。これはその近似値 */
    font-size: calc((100vw - var(--margin) * 2) / 6.4);
    white-space: nowrap;
    margin-left: -0.03em;
    padding-bottom: 0.02em;
    pointer-events: none;
    /* 写真の上では白、紙の上では墨になる */
    color: #fff;
    mix-blend-mode: difference;
  }

  .hero-name :global(.line) {
    display: inline-block;
    vertical-align: top;
  }

  .hero-name :global(.line + .line) {
    margin-left: 0.2em;
  }

  .hero-scroll {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 14px 18px;
    border-top: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .hero-hint {
    color: var(--mute);
  }

  .hero-scroll-arrow {
    justify-self: end;
    animation: nudge 2.4s var(--ease) infinite;
  }

  @keyframes nudge {
    0%,
    60%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(4px);
    }
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-fine {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  /* =============================== Shared =============================== */
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gutter);
    padding-top: 12px;
    border-top: 1px solid var(--line-strong);
    margin-bottom: clamp(56px, 10vh, 120px);
  }

  .sec-head h2 {
    font-weight: 500;
  }

  /* =============================== About =============================== */
  .about {
    padding-top: clamp(120px, 20vh, 220px);
  }

  .about-mirror {
    row-gap: 64px;
  }

  .about-ja {
    grid-column: 1 / span 6;
    padding-right: clamp(0px, 3vw, 48px);
  }

  .about-en {
    grid-column: 7 / span 6;
    padding-left: clamp(0px, 1vw, 16px);
  }

  .statement-en {
    font-family: var(--f-sans);
    font-weight: 450;
    font-size: clamp(26px, 3.1vw, 50px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    /* 和文の行と高さをそろえる */
    padding-top: 0.18em;
  }

  .about-ja .statement {
    font-size: clamp(24px, 2.75vw, 44px);
  }

  .about-body {
    margin-top: clamp(40px, 6vh, 64px);
    max-width: 34em;
    display: grid;
    gap: 1.2em;
    font-size: 15px;
    line-height: 2;
    color: var(--ink-2);
  }

  .about-en .about-body {
    line-height: 1.75;
    max-width: 30em;
  }

  .about-lists {
    margin-top: clamp(80px, 12vh, 140px);
  }

  .about-lists > div {
    grid-column: span 6;
  }

  .about-lists h3 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-strong);
  }

  .about-lists ul {
    columns: 2;
    column-gap: var(--gutter);
  }

  .about-lists li {
    break-inside: avoid;
    padding-block: 9px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.5;
  }

  /* =============================== Works =============================== */
  .works {
    padding-block: clamp(140px, 22vh, 240px) clamp(120px, 20vh, 200px);
  }

  /* 2件ずつ、大小と上下をずらして組む（6件で一巡） */
  .works-grid {
    row-gap: clamp(72px, 13vh, 160px);
    align-items: start;
  }

  .work-link {
    display: block;
  }

  .work-img {
    margin: 0;
    background: var(--paper-2);
  }

  .slot-0 { grid-column: 1 / span 5; }
  .slot-0 .work-img { aspect-ratio: 4 / 5; }

  .slot-1 { grid-column: 7 / span 6; margin-top: clamp(80px, 22vh, 260px); }
  .slot-1 .work-img { aspect-ratio: 4 / 3; }

  .slot-2 { grid-column: 1 / span 7; }
  .slot-2 .work-img { aspect-ratio: 16 / 9; }

  .slot-3 { grid-column: 9 / span 4; margin-top: clamp(60px, 16vh, 200px); }
  .slot-3 .work-img { aspect-ratio: 4 / 5; }

  .slot-4 { grid-column: 2 / span 5; }
  .slot-4 .work-img { aspect-ratio: 4 / 3; }

  .slot-5 { grid-column: 8 / span 5; margin-top: clamp(80px, 20vh, 240px); }
  .slot-5 .work-img { aspect-ratio: 16 / 10; }

  .work-meta {
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 12px;
    padding-top: 16px;
  }

  .work-no {
    color: var(--ink);
  }

  .work-main {
    display: grid;
    gap: 4px;
  }

  .work-title {
    word-break: auto-phrase;
    text-wrap: balance;
    font-size: clamp(19px, 1.7vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
  }

  .work-arrow {
    font-weight: 400;
    opacity: 0;
    transform: translateX(-0.5em);
    transition:
      opacity 0.4s ease,
      transform 0.7s var(--ease-out);
  }

  .work-side {
    display: grid;
    justify-items: end;
    text-align: right;
    gap: 4px;
  }

  .work-side .num {
    color: var(--ink);
  }

  /* 画像はガラス側（WebGL）が揺らぐので、CSS ではごく僅かに寄るだけ */
  .work-img > img {
    transition: transform 1.2s var(--ease-out);
  }

  @media (hover: hover) {
    .work-link:hover .work-arrow {
      opacity: 1;
      transform: none;
    }

    .work-link:hover .work-img:not(.is-gl) > img {
      transform: scale(1.03);
    }
  }

  .upcoming {
    margin-top: clamp(100px, 16vh, 180px);
  }

  .upcoming h3 {
    font-weight: 500;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-strong);
  }

  .upcoming li {
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr) auto;
    column-gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }

  .upcoming-title {
    color: var(--ink);
  }

  /* ============================== Contact ============================== */
  .contact {
    padding-bottom: clamp(100px, 16vh, 180px);
  }

  .contact-body {
    align-items: end;
    row-gap: 48px;
  }

  .contact-title {
    grid-column: 1 / span 8;
    font-family: var(--f-sans);
    font-weight: 500;
    font-size: clamp(56px, 9.4vw, 168px);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .contact-side {
    grid-column: 9 / -1;
    padding-bottom: 0.6em;
  }

  .contact-lead {
    font-size: 14px;
    color: var(--ink-2);
  }

  .contact-mail {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    margin-top: 16px;
    font-size: clamp(18px, 1.7vw, 26px);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .contact-mail-arrow {
    transition: transform 0.6s var(--ease-out);
  }

  .contact-mail:hover .contact-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }

  /* ============================== Tablet ============================== */
  @media (max-width: 1100px) {
    .work-side > span:last-child {
      display: none;
    }

    .contact-title {
      grid-column: 1 / -1;
    }

    .contact-side {
      grid-column: 1 / span 8;
    }
  }

  /* ============================== Mobile ============================== */
  @media (max-width: 760px) {
    .hero {
      height: auto;
      min-height: 100svh;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: auto auto auto auto auto;
    }

    .hero-photo {
      grid-column: 1 / -1;
      grid-row: 1;
      aspect-ratio: 682 / 1024;
      max-height: 72svh;
      width: 100%;
    }

    .hero-name {
      grid-row: 2;
      margin-top: -0.62em;
      font-size: calc((100vw - var(--margin) * 2) / 3.6);
      line-height: 0.84;
    }

    .hero-name :global(.line) {
      display: block;
    }

    .hero-name :global(.line + .line) {
      margin-left: 0;
    }

    .hero-left {
      grid-column: 1 / -1;
      grid-row: 3;
      padding-block: 28px 20px;
    }

    .hero-meta {
      grid-column: 1 / -1;
      grid-row: 4;
      margin-bottom: 28px;
    }

    .hero-scroll {
      grid-row: 5;
    }

    .about-ja,
    .about-en {
      grid-column: 1 / -1;
      padding: 0;
    }

    .about-lists > div {
      grid-column: 1 / -1;
    }

    .about-lists > div + div {
      margin-top: 40px;
    }

    .work {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    /* 縦長の1枚だけ内側に入れて、リズムを残す */
    .slot-3 {
      grid-column: 2 / span 3;
    }

    .works-grid {
      row-gap: 64px;
    }

    .contact-side {
      grid-column: 1 / -1;
    }
  }
</style>
