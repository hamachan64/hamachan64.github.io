---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import HoloCard from '../components/HoloCard.astro';
import profile from '../../assets/images/profile.jpg';

const works = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order
);

const skills = ['XR', 'Unity', 'Card Game', 'Immersive Design'];
---

<Base title="Yuki Hamaguchi | XR Creator Portfolio">
  <main>
    <!-- ============================== HERO ============================== -->
    <section id="hero" class="hero">
      <canvas id="holo-particles" aria-hidden="true"></canvas>

      <div class="container hero-inner">
        <div class="hero-text">
          <p class="kicker hero-kicker">XR ENGINEER / CREATOR — TOKYO</p>
          <h1 class="hero-title font-head" data-split-hero>
            Yuki<br />Hamaguchi
          </h1>
          <p class="hero-sub font-head text-holo" data-hero-fade>AR Card Creator</p>
          <p class="hero-vision" data-hero-fade>
            一枚のカードを入口に、現実と仮想が溶け合う<br
              class="pc-only"
            />イマーシブな体験をつくっています。
          </p>
        </div>

        <div class="hero-card-wrap" data-hero-card>
          <div class="hero-card holo-tilt">
            <Image
              src={profile}
              alt="Yuki Hamaguchi のプロフィール写真"
              width={640}
              densities={[1, 2]}
              loading="eager"
            />
            <span class="hero-card-sheen" aria-hidden="true"></span>
            <span class="hero-card-label font-head">YUKI HAMAGUCHI — XR CREATOR</span>
          </div>
        </div>
      </div>

      <div class="scroll-indicator font-head" aria-hidden="true">
        <span>SCROLL</span>
        <span class="scroll-line"></span>
      </div>
    </section>

    <!-- ============================== ABOUT ============================== -->
    <section id="about" class="section">
      <div class="container">
        <SectionTitle kicker="About" title="Creating Immersive Experiences" />
        <div class="about-grid">
          <div class="about-text" data-reveal>
            <p>
              XR Engineer / Creator based in Tokyo.
            </p>
            <p>
              XR技術をコアに据え、『カード』をはじめとする物理メディアへ落とし込むことで、現実的で非日常なイマーシブ体験を創ることを志しています。
            </p>
            <p>
              現実と仮想を融合させ、人々の心を動かす新しい価値を提供します。
            </p>
          </div>
          <ul class="skills" data-reveal-group>
            {
              skills.map((s) => (
                <li class="skill-chip font-head" data-reveal>
                  {s}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ==================== VISION（ピン留めスクラブ） ==================== -->
    <section id="vision" class="vision">
      <div class="vision-pin">
        <div class="container">
          <p class="vision-line font-head" data-scrub-text>PHYSICAL × VIRTUAL</p>
          <p class="vision-line vision-ja" data-scrub-text>一枚のカードから、</p>
          <p class="vision-line vision-ja" data-scrub-text>世界が立ち上がる。</p>
        </div>
      </div>
    </section>

    <!-- ============================== WORKS ============================== -->
    <section id="works" class="section">
      <div class="container">
        <SectionTitle kicker="Works" title="Selected Works" />
        <div class="works-grid" data-works-grid>
          {
            works.map((w) => (
              <div class="works-item" data-work-card>
                <HoloCard
                  title={w.data.title}
                  subtitle={w.data.subtitle}
                  concept={w.data.comingSoon ? 'Coming soon...' : w.data.concept}
                  cover={w.data.cover}
                  href={w.data.comingSoon ? undefined : `/${w.id}`}
                  transitionName={`work-${w.id}`}
                />
              </div>
            ))
          }
          <div class="works-item" data-work-card>
            <HoloCard title="Coming soon..." />
          </div>
          <div class="works-item" data-work-card>
            <HoloCard title="Coming soon..." />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= CONTACT ============================= -->
    <section id="contact" class="section contact">
      <div class="container">
        <SectionTitle kicker="Contact" title="Let's Create Together" />
        <p class="contact-lead" data-reveal>
          制作のご相談・コラボレーションなど、お気軽にご連絡ください。
        </p>
        <div class="contact-actions" data-reveal>
          <a href="mailto:yuuki.hama2186@gmail.com" class="btn-holo">GET IN TOUCH</a>
        </div>
        <div class="social" data-reveal-group>
          <a data-reveal href="https://x.com/hamaXR64" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
          <a data-reveal href="https://www.youtube.com/@Hamachan64" target="_blank" rel="noopener noreferrer">YouTube</a>
          <a data-reveal href="https://github.com/hamachan64" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ------------------------------ Hero ------------------------------ */
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: var(--header-h);
  }

  #holo-particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
    width: 100%;
  }

  .hero-kicker {
    margin-bottom: 22px;
  }

  .hero-title {
    font-size: clamp(3rem, 9vw, 6.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .hero-sub {
    font-size: clamp(1.05rem, 2.2vw, 1.4rem);
    font-weight: 500;
    letter-spacing: 0.2em;
    margin-bottom: 20px;
  }

  .hero-vision {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 2;
  }

  /* プロフィールを「ホロカード」として提示 */
  .hero-card-wrap {
    perspective: 1000px;
    justify-self: center;
  }

  .hero-card {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    position: relative;
    width: min(340px, 70vw);
    aspect-ratio: 63 / 88; /* トレカ比率 */
    border-radius: 18px;
    overflow: hidden;
    transform: rotate(4deg) rotateX(var(--rx)) rotateY(var(--ry));
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.55),
      0 0 60px rgba(167, 139, 250, 0.12);
    will-change: transform;
  }

  .hero-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-card-sheen {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        460px circle at var(--mx) var(--my),
        rgba(255, 255, 255, 0.22),
        transparent 45%
      ),
      conic-gradient(
        from 200deg at var(--mx) var(--my),
        rgba(110, 231, 255, 0.25),
        rgba(167, 139, 250, 0.25),
        rgba(255, 139, 216, 0.25),
        rgba(125, 255, 196, 0.25),
        rgba(110, 231, 255, 0.25)
      );
    mix-blend-mode: color-dodge;
    opacity: 0.5;
    pointer-events: none;
  }

  .hero-card-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 16px;
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.85);
    background: linear-gradient(transparent, rgba(7, 7, 13, 0.85));
  }

  .scroll-indicator {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    color: var(--text-faint);
  }

  .scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--holo-1), transparent);
    animation: scrollPulse 2s var(--ease-out) infinite;
  }

  @keyframes scrollPulse {
    0% {
      transform: scaleY(0);
      transform-origin: 0 0;
    }
    50% {
      transform: scaleY(1);
      transform-origin: 0 0;
    }
    51% {
      transform-origin: 0 100%;
    }
    100% {
      transform: scaleY(0);
      transform-origin: 0 100%;
    }
  }

  /* ------------------------------ About ------------------------------ */
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .about-text p {
    margin-bottom: 1.4em;
    color: var(--text-dim);
  }

  .about-text p:first-child {
    color: var(--text);
    font-family: var(--font-head);
    letter-spacing: 0.04em;
  }

  .skills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .skill-chip {
    padding: 0.6em 1.4em;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .skill-chip:hover {
    border-color: var(--holo-2);
    color: var(--holo-1);
  }

  /* ----------------------- Vision（ピン留め） ----------------------- */
  .vision {
    position: relative;
  }

  .vision-pin {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .vision-line {
    font-size: clamp(1.9rem, 6.5vw, 4.6rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .vision-line.vision-ja {
    font-family: var(--font-body);
    font-weight: 700;
  }

  /* スクラブ用：JSが文字単位に分割し .char の不透明度を制御 */
  .vision-line :global(.char) {
    opacity: 0.13;
    transform: none;
  }

  /* ------------------------------ Works ------------------------------ */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 32px);
  }

  :global(html.js) .works-item {
    opacity: 0;
    transform: translateY(60px) scale(0.96);
    will-change: transform, opacity;
  }

  /* ----------------------------- Contact ----------------------------- */
  .contact-lead {
    color: var(--text-dim);
    margin-bottom: 36px;
    max-width: 40em;
  }

  .contact-actions {
    margin-bottom: 48px;
  }

  .social {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .social a {
    font-family: var(--font-head);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--text-dim);
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .social a:hover {
    color: var(--holo-1);
    border-bottom-color: var(--holo-1);
  }

  /* --------------------------- Responsive --------------------------- */
  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-block: 48px;
    }

    .hero-card-wrap {
      order: -1;
    }

    .hero-card {
      width: min(240px, 62vw);
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .works-grid {
      grid-template-columns: 1fr;
    }

    .pc-only {
      display: none;
    }
  }

  @media (min-width: 861px) and (max-width: 1100px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Reduced motion: Works カードを即表示 */
  @media (prefers-reduced-motion: reduce) {
    .works-item {
      opacity: 1;
      transform: none;
    }

    .scroll-line {
      animation: none;
    }
  }
</style>
