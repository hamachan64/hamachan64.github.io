---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import { cardSrc } from '../lib/card';
import myCard from '../../assets/images/works/01/01-01.png';
import portrait from '../../assets/images/profile_t.jpg';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const released = works.filter((w) => !w.data.comingSoon);

const rows = await Promise.all(
  works.map(async (w) => {
    const img = w.data.card ?? w.data.cover;
    return {
      id: w.id,
      no: String(w.data.order).padStart(2, '0'),
      title: w.data.title,
      subtitle: w.data.subtitle,
      tech: w.data.tech,
      year: w.data.year,
      comingSoon: w.data.comingSoon,
      cover: w.data.cover,
      focus: w.data.cardFocus,
      src: img && !w.data.comingSoon ? await cardSrc(img) : undefined,
    };
  })
);
// 未発表の枠
const slots = [rows.length + 1, rows.length + 2].map((n) => String(n).padStart(2, '0'));

const heroSrc = await cardSrc(myCard);
const portraitSrc = await cardSrc(portrait);
const firstWork = rows.find((r) => r.src)!;

// 名前は1文字ずつ立ち上げる
const nameLines = ['Yuki', 'Hamaguchi'].map((w) =>
  [...w].map((c, i) => `<span class="ch" style="--c:${i}">${c}</span>`).join('')
);

const disciplines = ['AR / XR Experience', 'WebAR', 'Spatial Computing', 'Card & Game Design', 'Direction'];
const tools = ['Unity', 'Shader Graph', 'AR Foundation', 'Swift / visionOS', 'PICO'];
---

<Base title="Yuki Hamaguchi — AR Card Creator / XR Engineer">
  <main id="top">
    <!-- ================================ HERO ================================ -->
    <section class="hero wrap" aria-label="Introduction">
      <div class="hero-card card-anchor" data-card style="aspect-ratio: 639 / 1005">
        <img src={heroSrc} alt="Yuki Hamaguchi の AR 名刺カード" width="639" height="1005" />
      </div>

      <div class="hero-left">
        <p class="label" data-fade data-manual style="--d: 500ms">Portfolio 2025—2026</p>
        <Lines
          as="p"
          class="hero-tagline jp"
          lines={['一枚のカードから、', '世界が立ち上がる。']}
          delay={560}
          manual
        />
        <p class="hero-en en-note" data-fade data-manual style="--d: 760ms">
          Immersive experiences that begin<br />with a single card in your hand.
        </p>
      </div>

      <div class="hero-right">
        <p class="label" data-fade data-manual style="--d: 620ms">Based in Tokyo</p>
        <p class="label label-ink" data-fade data-manual style="--d: 680ms">
          <a href="#works" class="ul">Selected works <span class="num">01—{String(released.length).padStart(2, '0')}</span></a>
        </p>
      </div>

      <Lines as="h1" class="hero-name display by-char" lines={nameLines} manual delay={150} data-fit />

      <p class="hero-scroll label" data-fade data-manual style="--d: 900ms" aria-hidden="true">
        <span>Scroll to explore</span>
        <span class="hero-scroll-index num">No. 064 — はまちゃん</span>
        <span class="hero-scroll-arrow">↓</span>
      </p>
    </section>

    <!-- ================================ ABOUT =============================== -->
    <section id="about" class="about wrap">
      <div class="grid">
        <p class="sec-label label" data-fade><span class="num">(01)</span> About</p>
        <Lines
          as="h2"
          class="about-statement statement"
          lines={['カードは、手のひらに収まる', 'いちばん小さな世界の入口。', 'XR の技術で、その向こう側を', 'つくっています。']}
        />
      </div>

      <div class="grid about-body">
        <div class="about-card-col">
          <div class="about-card card-anchor" data-card style="aspect-ratio: 682 / 1024" data-focus="0.5 0.4">
            <img src={portraitSrc} alt="Yuki Hamaguchi のポートレート" width="682" height="1024" loading="lazy" />
          </div>
          <p class="label about-caption">Yuki Hamaguchi — Tokyo, JP</p>
        </div>

        <div class="about-text">
          <p class="jp about-lead" data-fade>
            東京を拠点に活動する XR エンジニア／クリエイター。XR 技術をコアに据え、カードをはじめとする物理メディアへ体験を落とし込むことで、現実の延長線上にある非日常をデザインしています。
          </p>
          <p class="jp" data-fade>
            触れられるものと、触れられないもの。その境界で人の心が動く瞬間をつくることが、私のテーマです。
          </p>
          <p class="en-note" data-fade>
            I'm a Tokyo-based XR engineer and creator. With XR at the core, I translate experiences into
            physical media — cards above all — to design the extraordinary that sits just beyond everyday reality.
          </p>

          <div class="about-lists">
            <div data-fade>
              <h3 class="label">Disciplines</h3>
              <ul>{disciplines.map((d) => <li>{d}</li>)}</ul>
            </div>
            <div data-fade style="--d: 120ms">
              <h3 class="label">Tools</h3>
              <ul>{tools.map((d) => <li>{d}</li>)}</ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================ WORKS =============================== -->
    <section id="works" class="works wrap">
      <div class="grid works-head">
        <p class="sec-label label" data-fade><span class="num">(02)</span> Selected Works</p>
        <h2 class="works-title display">
          <Lines as="span" lines={['Works']} />
          <sup class="works-count num" data-fade style="--d: 300ms">({String(released.length).padStart(2, '0')})</sup>
        </h2>
      </div>

      <div class="grid works-body">
        <ol class="works-list" data-works>
          {
            rows.map((r) =>
              r.comingSoon ? (
                <li class="row is-soon" data-row data-fade>
                  <span class="row-no label num">{r.no}</span>
                  <span class="row-main">
                    <span class="row-title jp">{r.title}</span>
                    <span class="row-sub label">{r.subtitle}</span>
                  </span>
                  <span class="row-tech label">In development</span>
                  <span class="row-year label">—</span>
                </li>
              ) : (
                <li data-fade>
                  <a
                    class="row"
                    href={`/${r.id}`}
                    data-row
                    data-card-preload={r.src}
                    data-focus={r.focus}
                  >
                    {r.cover && (
                      <span class="row-thumb" data-clip>
                        <Image src={r.cover} alt="" width={720} loading="lazy" />
                      </span>
                    )}
                    <span class="row-no label num">{r.no}</span>
                    <span class="row-main">
                      <span class="row-title jp">
                        {r.title}
                        <span class="row-arrow" aria-hidden="true">
                          →
                        </span>
                      </span>
                      <span class="row-sub label">{r.subtitle}</span>
                    </span>
                    <span class="row-tech label">{r.tech}</span>
                    <span class="row-year label num">{r.year}</span>
                  </a>
                </li>
              )
            )
          }
          {
            slots.map((n) => (
              <li class="row is-soon is-slot" data-row data-fade>
                <span class="row-no label num">{n}</span>
                <span class="row-main">
                  <span class="row-title">Coming soon</span>
                </span>
                <span class="row-tech label" />
                <span class="row-year label">—</span>
              </li>
            ))
          }
        </ol>

        <div class="works-card-col" aria-hidden="true">
          <div class="works-card-sticky">
            <div
              class="works-card card-anchor"
              data-card
              data-works-card
              data-src={firstWork.src}
              data-focus={firstWork.focus}
            >
              <img src={firstWork.src} alt="" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =============================== CONTACT ============================== -->
    <section id="contact" class="contact wrap">
      <div class="grid">
        <p class="sec-label label" data-fade><span class="num">(03)</span> Contact</p>
        <div class="contact-main">
          <Lines as="h2" class="contact-title display" lines={['Have a card', 'in mind?']} />
          <p class="jp contact-lead" data-fade>
            制作のご相談・コラボレーションなど、お気軽にご連絡ください。
          </p>
          <a class="contact-mail" href="mailto:yuuki.hama2186@gmail.com" data-fade>
            <span class="ul">yuuki.hama2186@gmail.com</span>
            <span class="contact-mail-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="contact-card-col">
          <div class="contact-card card-anchor" data-card data-face="back" style="aspect-ratio: 63 / 88" aria-hidden="true"></div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* =============================== Hero =============================== */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: 1fr auto auto;
    column-gap: var(--gutter);
    padding-top: var(--header-h);
  }

  .hero-card {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    width: clamp(200px, 19vw, 300px);
    margin-top: 2vh;
    transform: rotate(-3deg);
  }

  html.gl-ready .hero-card {
    transform: none;
  }

  .hero-left,
  .hero-right {
    grid-row: 1;
    align-self: end;
    padding-bottom: clamp(24px, 4vh, 48px);
  }

  .hero-left {
    grid-column: 1;
  }

  .hero-left .label {
    margin-bottom: 18px;
  }

  .hero-tagline {
    font-family: var(--f-min);
    font-weight: 500;
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.55;
    letter-spacing: 0.06em;
  }

  .hero-en {
    margin-top: 14px;
    color: var(--mute);
    font-size: 13px;
  }

  .hero-right {
    grid-column: 3;
    justify-self: end;
    text-align: right;
    display: grid;
    gap: 4px;
  }

  .hero-name {
    grid-column: 1 / -1;
    grid-row: 2;
    /* JS（data-fit）が左右マージンいっぱいに合わせる。これはその近似値 */
    font-size: calc((100vw - var(--margin) * 2) / 6.4);
    white-space: nowrap;
    margin-left: -0.03em;
    padding-bottom: 0.02em;
  }

  .hero-name :global(.line) {
    display: inline-block;
    vertical-align: top;
  }

  .hero-name :global(.line + .line) {
    margin-left: 0.2em;
  }

  .hero-scroll {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 14px 18px;
    border-top: 1px solid var(--line-strong);
  }

  .hero-scroll-index {
    text-transform: none;
  }

  .hero-scroll-arrow {
    justify-self: end;
    color: var(--ink);
    animation: nudge 2.4s var(--ease) infinite;
  }

  @keyframes nudge {
    0%,
    60%,
    100% {
      transform: none;
    }
    30% {
      transform: translateY(4px);
    }
  }

  /* =============================== Shared =============================== */
  .sec-label {
    grid-column: 1 / span 3;
    padding-top: 0.7em;
  }

  .sec-label .num {
    color: var(--ink);
    margin-right: 0.6em;
  }

  /* =============================== About =============================== */
  .about {
    padding-block: clamp(120px, 20vh, 220px) clamp(100px, 16vh, 180px);
  }

  .about-statement {
    grid-column: 4 / -1;
  }

  .about-body {
    margin-top: clamp(80px, 14vh, 160px);
    align-items: start;
  }

  .about-card-col {
    grid-column: 1 / span 3;
  }

  .about-card {
    width: 100%;
    max-width: 300px;
  }

  .about-caption {
    margin-top: 16px;
    white-space: nowrap;
  }

  .about-text {
    grid-column: 6 / span 6;
    display: grid;
    gap: 1.4em;
    font-size: 16px;
    line-height: 2;
  }

  .about-lead {
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.95;
  }

  .about-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    margin-top: 2.2em;
  }

  .about-lists h3 {
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
  }

  .about-lists li {
    padding-block: 7px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.5;
  }

  /* =============================== Works =============================== */
  .works {
    padding-block: clamp(60px, 10vh, 120px) clamp(120px, 20vh, 200px);
  }

  .works-head {
    align-items: end;
    margin-bottom: clamp(40px, 7vh, 80px);
  }

  .works-head .sec-label {
    align-self: start;
  }

  .works-title {
    grid-column: 4 / -1;
    font-size: clamp(96px, 17vw, 300px);
    display: flex;
    align-items: flex-start;
  }

  .works-count {
    font-family: var(--f-mono);
    font-size: clamp(12px, 1.1vw, 16px);
    font-weight: 400;
    letter-spacing: 0;
    margin-left: 0.6em;
    margin-top: 0.4em;
    vertical-align: top;
  }

  .works-body {
    align-items: start;
  }

  .works-list {
    grid-column: 1 / span 8;
    border-bottom: 1px solid var(--line);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3.4em minmax(0, 1fr) 15em 4em;
    align-items: baseline;
    column-gap: var(--gutter);
    padding-block: 28px 30px;
    border-top: 1px solid var(--line);
    transition: opacity 0.5s var(--ease-out);
  }

  li:first-child > .row,
  .row:first-child {
    border-top-color: var(--line-strong);
  }

  .row-thumb {
    display: none;
  }

  .row-main {
    display: grid;
    gap: 6px;
  }

  .row-title {
    font-family: var(--f-sans);
    font-size: clamp(20px, 2vw, 30px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    transition: transform 0.7s var(--ease-out);
  }

  .row-arrow {
    font-family: var(--f-sans);
    font-weight: 400;
    opacity: 0;
    transform: translateX(-0.6em);
    transition:
      opacity 0.4s ease,
      transform 0.7s var(--ease-out);
  }

  .row-year {
    text-align: right;
    color: var(--ink);
  }

  .row-no {
    color: var(--ink);
  }

  .is-soon {
    color: var(--mute);
  }

  .is-soon .row-no,
  .is-soon .row-year {
    color: var(--mute);
  }

  .is-slot .row-title {
    font-family: var(--f-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .is-slot {
    padding-block: 16px 18px;
  }

  @media (hover: hover) {
    .works-list.is-hovering .row:not(.is-active) {
      opacity: 0.28;
    }

    a.row.is-active .row-title {
      transform: translateX(14px);
    }

    a.row.is-active .row-arrow {
      opacity: 1;
      transform: none;
    }
  }

  .works-card-col {
    grid-column: 10 / -1;
    height: 100%;
  }

  .works-card-sticky {
    position: sticky;
    top: calc(50svh - min(26vw, 470px) * 1.25 / 2 + var(--header-h) / 3);
  }

  .works-card {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    margin-left: auto;
  }

  /* ============================== Contact ============================== */
  .contact {
    padding-bottom: clamp(80px, 12vh, 140px);
  }

  .contact > .grid {
    border-top: 1px solid var(--line-strong);
    padding-top: clamp(80px, 14vh, 140px);
  }

  .contact-main {
    grid-column: 4 / span 6;
  }

  .contact-title {
    font-size: clamp(64px, 10vw, 180px);
  }

  .contact-lead {
    margin-top: clamp(28px, 4vh, 48px);
    font-size: 15px;
  }

  .contact-mail {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    margin-top: 14px;
    font-size: clamp(20px, 2.6vw, 40px);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .contact-mail-arrow {
    transition: transform 0.6s var(--ease-out);
  }

  .contact-mail:hover .contact-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }

  .contact-card-col {
    grid-column: 11 / -1;
    align-self: end;
  }

  .contact-card {
    width: 100%;
    max-width: 200px;
    margin-left: auto;
    transform: rotate(4deg);
  }

  html.gl-ready .contact-card {
    transform: none;
  }

  /* ============================== Tablet ============================== */
  @media (max-width: 1100px) {
    .row {
      grid-template-columns: 2.6em minmax(0, 1fr) 4em;
    }

    .row-tech {
      display: none;
    }

    .works-list {
      grid-column: 1 / span 7;
    }

    .works-card-col {
      grid-column: 9 / -1;
    }

    .about-text {
      grid-column: 5 / -1;
    }
  }

  /* ============================== Mobile ============================== */
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto auto auto;
    }

    .hero-card {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(52vw, 230px);
      margin-top: 0;
    }

    .hero-left {
      grid-column: 1 / -1;
      grid-row: 2;
      padding-bottom: 20px;
    }

    .hero-right {
      display: none;
    }

    .hero-name {
      grid-row: 3;
      font-size: calc((100vw - var(--margin) * 2) / 3.6);
      line-height: 0.84;
    }

    .hero-name :global(.line) {
      display: block;
    }

    .hero-name :global(.line + .line) {
      margin-left: 0;
    }

    .hero-scroll {
      grid-template-columns: 1fr auto;
    }

    .hero-scroll-index {
      display: none;
    }

    .hero-scroll {
      grid-row: 4;
    }

    .sec-label {
      grid-column: 1 / -1;
      margin-bottom: 28px;
    }

    .about-statement {
      grid-column: 1 / -1;
      font-size: clamp(22px, 6.4vw, 30px);
    }

    .about-card-col {
      grid-column: 1 / span 2;
    }

    .about-text {
      grid-column: 1 / -1;
      margin-top: 48px;
    }

    .about-lists {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .works-title {
      grid-column: 1 / -1;
      font-size: 30vw;
    }

    .works-list {
      grid-column: 1 / -1;
    }

    .works-card-col {
      display: none;
    }

    .row {
      grid-template-columns: 2.4em minmax(0, 1fr) auto;
      padding-block: 18px 26px;
    }

    .row-thumb {
      display: block;
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      margin-bottom: 18px;
      background: var(--paper-2);
    }

    .row-thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .contact-main {
      grid-column: 1 / -1;
    }

    .contact-card-col {
      grid-column: 3 / -1;
      grid-row: 1;
      margin-bottom: 24px;
    }

    .contact-card {
      max-width: 110px;
    }
  }
</style>
