---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import WorksSection from '../components/WorksSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import portraitWide from '../../assets/images/profile.jpg';
import portraitTall from '../../assets/images/profile_t.jpg';

const released = (await getCollection('works')).filter((w) => !w.data.comingSoon);
const pad = (n: number) => String(n).padStart(2, '0');

// Hero：PC は横長、モバイルは縦長。どちらも本人と鏡像が向かい合う構図
const wide = await getImage({ src: portraitWide, widths: [720, 1024], format: 'webp', quality: 86 });
const tall = await getImage({ src: portraitTall, widths: [480, 682], format: 'webp', quality: 86 });
// 継ぎ目（本人と鏡像の境）の位置。画像幅に対する割合
const PORTRAIT_SEAM = 0.4902; // profile.jpg
const PORTRAIT_SEAM_TALL = 0.4912; // profile_t.jpg

// 名前は1文字ずつ立ち上げる
const nameLines = ['Yuki', 'Hamaguchi'].map((w) =>
  [...w].map((c, i) => `<span class="ch" style="--c:${i}">${c}</span>`).join('')
);
---

<Base title="Yuki Hamaguchi — AR Card Creator / XR Engineer">
  <main id="top">
    <section class="hero wrap" aria-label="Introduction">
      <figure
        class="hero-photo glass"
        data-glass
        data-src={wide.src}
        data-seam={PORTRAIT_SEAM}
        data-src-tall={tall.src}
        data-seam-tall={PORTRAIT_SEAM_TALL}
        data-focus="0.5 0.32"
        data-clip
        data-manual
      >
        <picture>
          <source media="(max-width: 760px)" srcset={tall.srcSet.attribute} sizes="100vw" />
          <img
            src={wide.src}
            srcset={wide.srcSet.attribute}
            sizes="(max-width: 760px) 100vw, 75vw"
            width="1024"
            height="819"
            alt="Yuki Hamaguchi のポートレート。ガラスに映った自分と向かい合っている"
            fetchpriority="high"
          />
        </picture>
        <figcaption class="hero-photo-caps" aria-hidden="true">
          <span>Physical</span>
          <span>Virtual</span>
        </figcaption>
      </figure>

      <div class="hero-left">
        <p class="label" data-fade data-manual style="--d: 500ms">Portfolio 2025—2026</p>
        <Lines
          as="p"
          class="hero-tagline jp"
          lines={['XR技術と物理表現を', '手掛かりに、', '現実的で非日常な', 'イマーシブ体験を創る']}
          delay={560}
          manual
        />
        <p class="hero-en" data-fade data-manual style="--d: 760ms">
          Creating immersive experiences — real, yet extraordinary — through XR technology and physical expression.
        </p>
      </div>

      <p class="hero-meta label" data-fade data-manual style="--d: 840ms">
        Based in Tokyo<br />
        <a href="/works" class="ul label-ink">Works <span class="num">01—{pad(released.length)}</span></a>
      </p>

      <Lines as="h1" class="hero-name display by-char" lines={nameLines} manual delay={350} data-fit />

    </section>

    <AboutSection />
    <WorksSection />
    <ContactSection />
  </main>
</Base>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto;
    padding-bottom: clamp(16px, 2.5vh, 28px);
    column-gap: var(--gutter);
    padding-top: calc(var(--header-h) + 4px);
  }

  /* 主役：本人と鏡像のポートレート */
  .hero-photo {
    grid-column: 4 / -1;
    grid-row: 1 / span 2;
    margin: 0;
    background: #161615;
  }

  .hero-photo img {
    object-position: 50% 32%;
    filter: contrast(1.1) brightness(0.98);
  }

  .hero-photo-caps {
    position: absolute;
    inset: 14px 16px auto;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: rgba(235, 233, 228, 0.7);
    pointer-events: none;
  }

  .hero-left {
    grid-column: 1 / span 3;
    grid-row: 1;
    align-self: start;
    padding-top: clamp(16px, 3vh, 32px);
    padding-right: 8px;
  }

  .hero-left > .label:first-child {
    margin-bottom: 18px;
  }

  .hero-tagline {
    font-family: var(--f-min);
    font-weight: 500;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.6;
    letter-spacing: 0.05em;
  }

  .hero-en {
    margin-top: 14px;
    color: var(--mute);
    font-size: 13px;
    line-height: 1.6;
  }

  .hero-meta {
    grid-column: 1 / span 3;
    grid-row: 1;
    align-self: end;
    margin-bottom: clamp(20px, 3vh, 32px);
    line-height: 1.7;
  }

  .hero-name {
    grid-column: 1 / -1;
    grid-row: 2;
    position: relative;
    z-index: 2;
    /* JS（data-fit）が左右マージンいっぱいに合わせる。これはその近似値 */
    font-size: calc((100vw - var(--margin) * 2) / 6.4);
    white-space: nowrap;
    margin-left: -0.03em;
    padding-bottom: 0.02em;
    pointer-events: none;
    /* 写真の上では白、紙の上では墨になる */
    color: #fff;
    mix-blend-mode: difference;
  }

  .hero-name :global(.line) {
    display: inline-block;
    vertical-align: top;
  }

  .hero-name :global(.line + .line) {
    margin-left: 0.2em;
  }

  @media (max-width: 760px) {
    .hero {
      height: auto;
      min-height: 100svh;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: auto auto auto auto;
    }

    .hero-photo {
      grid-column: 1 / -1;
      grid-row: 1;
      aspect-ratio: 682 / 1024;
      max-height: 72svh;
      width: 100%;
    }

    .hero-name {
      grid-row: 2;
      margin-top: -0.62em;
      font-size: calc((100vw - var(--margin) * 2) / 3.6);
      line-height: 0.84;
    }

    .hero-name :global(.line) {
      display: block;
    }

    .hero-name :global(.line + .line) {
      margin-left: 0;
    }

    .hero-left {
      grid-column: 1 / -1;
      grid-row: 3;
      padding-block: 28px 20px;
    }

    .hero-meta {
      grid-column: 1 / -1;
      grid-row: 4;
      margin-bottom: 8px;
    }
  }
</style>
