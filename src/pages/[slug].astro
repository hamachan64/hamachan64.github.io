---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Film from '../components/Film.astro';
import { cardSrc } from '../lib/card';

export async function getStaticPaths() {
  const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
  const released = works.filter((w) => !w.data.comingSoon);
  return works.map((work) => {
    const i = released.indexOf(work);
    const next = i === -1 ? released[0] : released[(i + 1) % released.length];
    return { params: { slug: work.id }, props: { work, next, total: released.length } };
  });
}

const { work, next, total } = Astro.props;
const { data } = work;
const { Content } = await render(work);
const no = String(data.order).padStart(2, '0');
const cardImg = data.card ?? data.cover;
const src = cardImg ? await cardSrc(cardImg) : undefined;
const meta = [
  { k: 'Role', v: data.role },
  { k: 'Tech', v: data.tech },
  { k: 'Year', v: data.year },
].filter((m) => m.v);
---

<Base title={`${data.title} — ${data.subtitle} | Yuki Hamaguchi`} description={data.concept ?? `${data.subtitle} by Yuki Hamaguchi`}>
  <main id="top" class="detail">
    <!-- ================================ HERO ================================ -->
    <section class="d-hero wrap grid">
      <div class="d-hero-top">
        <a class="label label-ink back" href="/#works">← Index</a>
        <p class="label num" data-fade data-manual style="--d: 200ms">
          Project {no}{!data.comingSoon && <> / {String(total).padStart(2, '0')}</>}
        </p>
      </div>

      <div class="d-hero-text">
        <p class="label d-sub" data-fade data-manual style="--d: 260ms">{data.subtitle}</p>
        <Lines as="h1" class="d-title jp" lines={[data.title]} manual delay={120} />
      </div>

      <div class="d-card-col">
        {
          src ? (
            <div class="d-card card-anchor" data-card data-src={src} data-focus={data.cardFocus}>
              <img src={src} alt={data.title} loading="eager" />
            </div>
          ) : (
            <div class="d-card card-anchor" data-card data-face="back" aria-hidden="true" />
          )
        }
      </div>

      {
        meta.length > 0 && (
          <dl class="d-meta">
            {meta.map((m, i) => (
              <div data-fade data-manual style={`--d:${380 + i * 70}ms`}>
                <dt class="label">{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </section>

    {
      data.comingSoon ? (
        <section class="wrap grid d-block">
          <p class="d-label label">Status</p>
          <div class="d-col">
            <Lines as="p" class="statement" lines={['いま、カードを刷っています。']} />
            <p class="en-note d-en" data-fade>
              In development. Coming soon.
            </p>
          </div>
        </section>
      ) : (
        <>
          {data.concept && (
            <section class="wrap grid d-block">
              <p class="d-label label" data-fade>Concept</p>
              <div class="d-col">
                <Lines as="p" class="statement d-concept" lines={[data.concept]} />
                {data.conceptEn && (
                  <p class="en-note d-en" data-fade>
                    {data.conceptEn}
                  </p>
                )}
              </div>
            </section>
          )}

          <section class="wrap grid d-block">
            <p class="d-label label" data-fade>Overview</p>
            <div class="d-col d-prose jp" data-fade>
              <Content />
            </div>
          </section>

          {data.youtube && (
            <section class="wrap grid d-block">
              <p class="d-label label" data-fade>Film</p>
              <div class:list={['d-film', `is-${data.youtubeAspect}`]}>
                <Film id={data.youtube} title={data.title} poster={cardImg} aspect={data.youtubeAspect} />
              </div>
            </section>
          )}

          {data.gallery.length > 0 && (
            <section class="wrap d-block d-gallery-wrap">
              <div class="grid">
                <p class="d-label label" data-fade>
                  Gallery <span class="num">({String(data.gallery.length).padStart(2, '0')})</span>
                </p>
              </div>
              <div class="grid d-gallery">
                {data.gallery.map((img, i) => (
                  <figure class:list={['g-item', `g-${i % 4}`]}>
                    <div class="g-img" data-clip>
                      <Image src={img} alt={`${data.title} — ${i + 1}`} width={1400} loading="lazy" />
                    </div>
                    <figcaption class="label num">
                      {no}.{String(i + 1).padStart(2, '0')}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}
        </>
      )
    }

    <!-- ============================ NEXT PROJECT ============================ -->
    {
      next && next.id !== work.id && (
        <a class="d-next wrap" href={`/${next.id}`}>
          <span class="label">Next project — {String(next.data.order).padStart(2, '0')}</span>
          <span class="d-next-title jp">
            {next.data.title}
            <span class="d-next-arrow" aria-hidden="true">→</span>
          </span>
          <span class="label">{next.data.subtitle}</span>
        </a>
      )
    }
  </main>
</Base>

<style>
  /* =============================== Hero =============================== */
  .d-hero {
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 8px);
    padding-bottom: 28px;
    grid-template-rows: auto 1fr auto;
    row-gap: 24px;
  }

  .d-hero-top {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    padding-block: 12px;
    border-top: 1px solid var(--line-strong);
  }

  .back:hover {
    color: var(--mute);
  }

  .d-hero-text {
    grid-column: 1 / span 8;
    grid-row: 2;
    align-self: end;
  }

  .d-sub {
    margin-bottom: 18px;
  }

  .d-title {
    font-family: var(--f-sans);
    text-wrap: balance;
    font-size: clamp(38px, 7.2vw, 128px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .d-card-col {
    grid-column: 9 / -1;
    grid-row: 2 / span 2;
    align-self: center;
  }

  .d-card {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 4 / 5;
    margin-left: auto;
  }

  .d-meta {
    grid-column: 1 / span 8;
    grid-row: 3;
    display: grid;
    grid-template-columns: 1fr 1.6fr 0.6fr;
    gap: var(--gutter);
    margin-top: 20px;
  }

  .d-meta > div {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .d-meta dt {
    margin-bottom: 6px;
  }

  .d-meta dd {
    font-size: 14px;
    line-height: 1.6;
  }

  /* ============================== Blocks ============================== */
  .d-block {
    padding-block: clamp(72px, 12vh, 140px) 0;
  }

  .d-label {
    grid-column: 1 / span 3;
    padding-top: 0.6em;
  }

  .d-col {
    grid-column: 4 / span 8;
  }

  .d-concept {
    font-size: clamp(24px, 2.8vw, 44px);
  }

  .d-en {
    margin-top: 28px;
    max-width: 36em;
  }

  .d-prose {
    font-size: 16px;
    line-height: 2.1;
    max-width: 38em;
  }

  .d-prose :global(p + p) {
    margin-top: 1.3em;
  }

  .d-prose :global(.prose-en) {
    margin-top: 2.6em;
    padding-top: 1.6em;
    border-top: 1px solid var(--line);
    font-family: var(--f-sans);
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .d-film.is-vertical {
    grid-column: 4 / span 4;
  }

  .d-film.is-wide {
    grid-column: 4 / -1;
  }

  /* ============================== Gallery ============================== */
  .d-gallery {
    margin-top: 40px;
    row-gap: clamp(48px, 8vh, 100px);
    align-items: start;
  }

  .g-item {
    margin: 0;
  }

  .g-0 {
    grid-column: 1 / span 7;
  }

  .g-1 {
    grid-column: 9 / -1;
    margin-top: 22vh;
  }

  .g-2 {
    grid-column: 3 / span 5;
  }

  .g-3 {
    grid-column: 8 / -1;
    margin-top: 12vh;
  }

  .g-img {
    overflow: hidden;
    background: var(--paper-2);
  }

  .g-img :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 10px;
  }

  /* ============================ Next project ============================ */
  .d-next {
    display: grid;
    gap: 12px;
    margin-top: clamp(120px, 20vh, 220px);
    padding-block: clamp(40px, 6vh, 64px) clamp(64px, 12vh, 120px);
    border-top: 1px solid var(--line-strong);
  }

  .d-next-title {
    font-family: var(--f-sans);
    font-size: clamp(40px, 7vw, 120px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    transition: transform 0.9s var(--ease-out);
  }

  .d-next-arrow {
    font-family: var(--f-sans);
    font-weight: 300;
    transition: transform 0.9s var(--ease-out);
  }

  .d-next:hover .d-next-title {
    transform: translateX(0.12em);
  }

  .d-next:hover .d-next-arrow {
    transform: translateX(0.2em);
  }

  /* ============================== Mobile ============================== */
  @media (max-width: 1100px) {
    .d-meta {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .d-meta > div {
      display: grid;
      grid-template-columns: 5em 1fr;
      padding-block: 10px;
    }
  }

  @media (max-width: 760px) {
    .d-hero {
      grid-template-rows: auto auto auto auto;
    }

    .d-card-col {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
      width: 62vw;
    }

    .d-hero-text {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    .d-meta {
      grid-column: 1 / -1;
      grid-row: 4;
    }

    .d-label {
      grid-column: 1 / -1;
      margin-bottom: 20px;
    }

    .d-col,
    .d-film.is-wide {
      grid-column: 1 / -1;
    }

    .d-film.is-vertical {
      grid-column: 1 / span 3;
    }

    .g-0,
    .g-1,
    .g-2,
    .g-3 {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .g-1,
    .g-3 {
      grid-column: 2 / -1;
    }
  }
</style>
