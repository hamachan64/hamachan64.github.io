---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Film from '../components/Film.astro';
import { previewSrc } from '../lib/images';
import { ogImage } from '../lib/ogp';

export async function getStaticPaths() {
  const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
  const released = works.filter((w) => !w.data.comingSoon);
  return works.map((work) => {
    const i = released.indexOf(work);
    const next = i === -1 ? released[0] : released[(i + 1) % released.length];
    return { params: { slug: work.id }, props: { work, next, total: released.length } };
  });
}

const { work, next, total } = Astro.props;
const { data } = work;
const { Content } = await render(work);
const no = String(data.order).padStart(2, '0');
const cardImg = data.card ?? data.cover;
const src = cardImg ? await previewSrc(cardImg) : undefined;
const achievements = await Promise.all(
  data.achievements.map(async (a) => ({ ...a, thumb: (a.url && (await ogImage(a.url))) || a.image })),
);
// ギャラリーは 2 枚ずつの行にし、行内の高さを揃える（縦横比はトリミングせず元のまま）
const galleryRows: { img: ImageMetadata; i: number }[][] = [];
data.gallery.forEach((img, i) => {
  if (i % 2 === 0) galleryRows.push([]);
  galleryRows[galleryRows.length - 1].push({ img, i });
});
const ratio = (img: ImageMetadata) => +(img.width / img.height).toFixed(4);
const meta = [
  { k: 'Role', v: data.role },
  { k: 'Tech', v: data.tech },
  { k: 'Year', v: data.year },
].filter((m) => m.v);
---

<Base title={`${data.title}${data.subtitle ? ` — ${data.subtitle}` : ''} | Yuki Hamaguchi`} description={data.concept ?? `${data.title} by Yuki Hamaguchi`}>
  <main id="top" class="detail">
    <!-- ================================ HERO ================================ -->
    <section class="d-hero wrap grid">
      <div class="d-hero-top">
        <a class="label label-ink back" href="/works">← Works</a>
        <p class="label num" data-fade data-manual style="--d: 200ms">
          Project {no}{!data.comingSoon && <> / {String(total).padStart(2, '0')}</>}
        </p>
      </div>

      <div class="d-hero-text">
        <p class="label d-sub" data-fade data-manual style="--d: 260ms">{data.subtitle}</p>
        <Lines as="h1" class="d-title jp" lines={[data.title]} manual delay={120} />
      </div>

      {
        src ? (
          <figure class="d-visual glass" data-glass data-src={src} data-focus={data.cardFocus} data-clip data-manual>
            <img src={src} alt={data.title} loading="eager" />
          </figure>
        ) : (
          <div class="d-visual d-visual-empty" aria-hidden="true">
            <span class="label">In development</span>
          </div>
        )
      }

      {
        meta.length > 0 && (
          <dl class="d-meta">
            {meta.map((m, i) => (
              <div data-fade data-manual style={`--d:${380 + i * 70}ms`}>
                <dt class="label">{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </section>

    {
      data.comingSoon ? (
        <section class="wrap grid d-block">
          <p class="d-label label">Status</p>
          <div class="d-col">
            <Lines as="p" class="statement" lines={['ただいま制作中です。']} />
            <p class="en-note d-en" data-fade>
              In development. Coming soon.
            </p>
          </div>
        </section>
      ) : (
        <>
          {data.concept && (
            <section class="wrap grid d-block">
              <p class="d-label label" data-fade>Concept</p>
              <div class="d-col">
                <Lines as="p" class="statement d-concept" lines={[data.concept]} />
                {data.conceptEn && (
                  <p class="en-note d-en" data-fade>
                    {data.conceptEn}
                  </p>
                )}
              </div>
            </section>
          )}

          <section class="wrap grid d-block">
            <p class="d-label label" data-fade>Overview</p>
            <div class="d-col d-prose jp" data-fade>
              <Content />
            </div>
          </section>

          {achievements.length > 0 && (
            <section class="wrap grid d-block">
              <p class="d-label label" data-fade>Achievements</p>
              <ul class="d-col d-ach" data-fade>
                {achievements.map((a) => {
                  const body = (
                    <>
                      <span class="num d-ach-date">{a.date}</span>
                      {a.thumb && (
                        <span class="d-ach-img">
                          {typeof a.thumb === 'string' ? (
                            <Image src={a.thumb} alt="" width={240} height={150} inferSize loading="lazy" />
                          ) : (
                            <Image src={a.thumb} alt="" width={240} loading="lazy" />
                          )}
                        </span>
                      )}
                      <span class="d-ach-text">
                        <span class="jp d-ach-title">{a.title}</span>
                        <span class="label">
                          {[a.kind, a.url && `${new URL(a.url).hostname.replace(/^www\./, '')} ↗`].filter(Boolean).join(' · ')}
                        </span>
                      </span>
                    </>
                  );
                  return (
                    <li>
                      {a.url ? (
                        <a class="d-ach-row is-link" href={a.url} target="_blank" rel="noopener noreferrer">
                          {body}
                        </a>
                      ) : (
                        <div class="d-ach-row">{body}</div>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {data.youtube && (
            <section class="wrap grid d-block">
              <p class="d-label label" data-fade>Film</p>
              <div class:list={['d-film', `is-${data.youtubeAspect}`]}>
                <Film id={data.youtube} title={data.title} poster={cardImg} aspect={data.youtubeAspect} />
              </div>
            </section>
          )}

          {data.gallery.length > 0 && (
            <section class="wrap d-block d-gallery-wrap">
              <div class="grid">
                <p class="d-label label" data-fade>
                  Gallery <span class="num">({String(data.gallery.length).padStart(2, '0')})</span>
                </p>
              </div>
              <div class="d-gallery">
                {galleryRows.map((row) => (
                  <div
                    class="g-row"
                    style={`--sum:${row.reduce((s, { img }) => s + ratio(img), 0)};--n:${row.length}`}
                  >
                    {row.map(({ img, i }) => (
                      <figure class="g-item" style={`--r:${ratio(img)}`}>
                        <div class="g-img" data-clip>
                          <Image src={img} alt={`${data.title} — ${i + 1}`} width={1400} loading="lazy" />
                        </div>
                        <figcaption class="label num">
                          {no}.{String(i + 1).padStart(2, '0')}
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                ))}
              </div>
            </section>
          )}
        </>
      )
    }

    <!-- ============================ NEXT PROJECT ============================ -->
    {
      next && next.id !== work.id && (
        <a class="d-next wrap" href={`/${next.id}`}>
          <span class="label">Next project — {String(next.data.order).padStart(2, '0')}</span>
          <span class="d-next-title jp">
            {next.data.title}
            <span class="d-next-arrow" aria-hidden="true">→</span>
          </span>
          <span class="label">{next.data.subtitle}</span>
        </a>
      )
    }
  </main>
</Base>

<style>
  /* =============================== Hero =============================== */
  .d-hero {
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 8px);
    padding-bottom: 28px;
    grid-template-rows: auto 1fr auto;
    row-gap: 24px;
  }

  .d-hero-top {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    padding-block: 12px;
    border-top: 1px solid var(--line-strong);
  }

  .back:hover {
    color: var(--mute);
  }

  .d-hero-text {
    grid-column: 1 / span 7;
    grid-row: 2;
    align-self: end;
  }

  .d-sub {
    margin-bottom: 18px;
  }

  .d-title {
    font-family: var(--f-sans);
    text-wrap: balance;
    font-size: clamp(38px, 7.2vw, 128px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .d-visual {
    grid-column: 8 / -1;
    grid-row: 2 / span 2;
    margin: 0;
    min-height: 0;
    height: calc(100svh - var(--header-h) - 96px);
    background: var(--paper-2);
  }

  .d-visual-empty {
    display: grid;
    place-items: center;
  }

  .d-meta {
    grid-column: 1 / span 7;
    grid-row: 3;
    display: grid;
    grid-template-columns: 1fr 1.6fr 0.6fr;
    gap: var(--gutter);
    margin-top: 20px;
  }

  .d-meta > div {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .d-meta dt {
    margin-bottom: 6px;
  }

  .d-meta dd {
    font-size: 14px;
    line-height: 1.6;
  }

  /* ============================== Blocks ============================== */
  .d-block {
    padding-block: clamp(72px, 12vh, 140px) 0;
  }

  .d-label {
    grid-column: 1 / span 3;
    padding-top: 0.6em;
  }

  .d-col {
    grid-column: 4 / span 8;
  }

  .d-concept {
    font-size: clamp(24px, 2.8vw, 44px);
  }

  .d-en {
    margin-top: 28px;
    max-width: 36em;
  }

  .d-prose {
    font-size: 16px;
    line-height: 2.1;
    max-width: 38em;
  }

  .d-prose :global(p + p) {
    margin-top: 1.3em;
  }

  .d-prose :global(.prose-en) {
    margin-top: 2.6em;
    padding-top: 1.6em;
    border-top: 1px solid var(--line);
    font-family: var(--f-sans);
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .d-ach {
    border-top: 1px solid var(--line-strong);
  }

  .d-ach li {
    border-bottom: 1px solid var(--line);
  }

  .d-ach-row {
    display: flex;
    align-items: center;
    gap: var(--gutter);
    padding-block: 14px;
    font-size: 15px;
    line-height: 1.7;
  }

  .d-ach-row.is-link {
    transition: opacity 0.4s var(--ease-out);
  }

  .d-ach-row.is-link:hover {
    opacity: 0.6;
  }

  .d-ach-date {
    flex: none;
    width: 5em;
  }

  .d-ach-img {
    flex: none;
    width: 120px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper-2);
  }

  .d-ach-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .d-ach-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .d-film.is-vertical {
    grid-column: 4 / span 4;
  }

  .d-film.is-wide {
    grid-column: 4 / -1;
  }

  /* ============================== Gallery ============================== */
  .d-gallery {
    display: grid;
    row-gap: clamp(32px, 5vh, 56px);
    margin-top: 40px;
  }

  /* 行内は縦横比に応じて幅を配分 → 高さが揃う。縦長が並ぶ行は画面高さで頭打ち */
  .g-row {
    display: flex;
    gap: var(--gutter);
    width: min(100%, calc(var(--sum) * 78svh + (var(--n) - 1) * var(--gutter)));
  }

  .g-item {
    flex: var(--r) 1 0;
    min-width: 0;
    margin: 0;
  }

  .g-img {
    aspect-ratio: var(--r);
    overflow: hidden;
    background: var(--paper-2);
  }

  .g-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 10px;
  }

  /* ============================ Next project ============================ */
  .d-next {
    display: grid;
    gap: 12px;
    margin-top: clamp(120px, 20vh, 220px);
    padding-block: clamp(40px, 6vh, 64px) clamp(64px, 12vh, 120px);
    border-top: 1px solid var(--line-strong);
  }

  .d-next-title {
    font-family: var(--f-sans);
    font-size: clamp(40px, 7vw, 120px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    transition: transform 0.9s var(--ease-out);
  }

  .d-next-arrow {
    font-family: var(--f-sans);
    font-weight: 300;
    transition: transform 0.9s var(--ease-out);
  }

  .d-next:hover .d-next-title {
    transform: translateX(0.12em);
  }

  .d-next:hover .d-next-arrow {
    transform: translateX(0.2em);
  }

  /* ============================== Mobile ============================== */
  @media (max-width: 1100px) {
    .d-meta {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .d-meta > div {
      display: grid;
      grid-template-columns: 5em 1fr;
      padding-block: 10px;
    }
  }

  @media (max-width: 760px) {
    .d-hero {
      grid-template-rows: auto auto auto auto;
    }

    .d-visual {
      grid-column: 1 / -1;
      grid-row: 2;
      height: auto;
      aspect-ratio: 4 / 5;
    }

    .d-hero-text {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    .d-meta {
      grid-column: 1 / -1;
      grid-row: 4;
    }

    .d-label {
      grid-column: 1 / -1;
      margin-bottom: 20px;
    }

    .d-col,
    .d-film.is-wide {
      grid-column: 1 / -1;
    }

    .d-film.is-vertical {
      grid-column: 1 / span 3;
    }

    .d-ach-row {
      flex-wrap: wrap;
      gap: 8px 16px;
    }

    .d-ach-img {
      width: 96px;
    }

    .g-row {
      flex-direction: column;
      row-gap: clamp(32px, 5vh, 56px);
      width: 100%;
    }

    .g-item {
      flex: none;
    }
  }
</style>
